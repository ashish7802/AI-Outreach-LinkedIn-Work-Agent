# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
WORKSPACE_ID=ws_default_001
TIMEZONE=Asia/Kolkata
CRON_SECRET=generate_a_secure_random_string_here

# Supabase Credentials (optional in local fallback demo mode; required for persistent cloud DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model Provider (Options: mock | grok | openai)
MODEL_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROK_API_KEY=
GROK_MODEL=grok-2-1212

# Messaging Integrations
# Email (Resend or SMTP provider)
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@yourdomain.com
WEBHOOK_SIGNING_SECRET=secure_webhook_secret_here

# Official LinkedIn API (Optional for publishing; if absent, ready-to-copy drafts are generated)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_PERSON_URN=

# Safety & Policy Limits
DAILY_SEND_CAP_PER_CHANNEL=50
QUIET_HOURS_START=21
QUIET_HOURS_END=8
REQUIRE_MANUAL_REVIEW_FOR_NEW_LEADS=false
