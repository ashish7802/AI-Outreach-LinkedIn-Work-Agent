# ==============================================================================
# AI Outreach & LinkedIn Work Agent - Environment Configuration (.env.example)
#
# NOTE: This file contains variable names, descriptions, and safe placeholders only.
# NEVER commit real API keys, access tokens, or service-role secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE / PUBLIC CLIENT VARIABLES (Exposed to the frontend)
# ------------------------------------------------------------------------------
# The canonical public URL of your deployed application or local server
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client, subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY PERSISTENCE & SECURITY SECRETS (NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS for backend worker queues and scans)
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Shared Secret for scheduled Vercel Crons & background automation triggers
# Generate via: openssl rand -hex 32
CRON_SECRET=generate_a_secure_random_32_byte_string_here

# Internal Server-to-Server API Key (Optional, for trusted external callers)
INTERNAL_API_KEY=optional_secure_internal_api_key_here

# Active Tenant / Workspace Identifier
WORKSPACE_ID=ws_default_001

# Workspace Scheduling & Quiet Hours Timezone
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 3. AI MODEL PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Active AI provider: 'openai' | 'grok' | 'mock'
# (Defaults to deterministic 'mock' if external API keys are omitted in development)
MODEL_PROVIDER=mock

# OpenAI API Configuration (Server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# xAI Grok API Configuration (Server-side only)
GROK_API_KEY=
GROK_MODEL=grok-2-1212

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL MESSAGING & SIGNED WEBHOOKS
# ------------------------------------------------------------------------------
# Resend API Key for verified outbound email dispatch
RESEND_API_KEY=

# Verified sender email address configured in Resend Domains
RESEND_FROM_EMAIL=outreach@yourdomain.com

# Webhook signing secret (From Resend/Svix webhook settings) for HMAC verification
WEBHOOK_SIGNING_SECRET=whsec_your_resend_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 5. OFFICIAL LINKEDIN REST API INTEGRATION
# ------------------------------------------------------------------------------
# If omitted or unconfigured, the system automatically creates ready-to-copy
# drafts rather than simulating unauthorized browser sessions.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here

# ------------------------------------------------------------------------------
# 6. SERVER-SIDE DETERMINISTIC POLICY GUARDRAILS
# ------------------------------------------------------------------------------
# Maximum outbound message dispatch per channel per day
DAILY_SEND_CAP_PER_CHANNEL=50

# Quiet hours start hour in 24hr format (e.g. 21 = 9:00 PM IST)
QUIET_HOURS_START=21

# Quiet hours end hour in 24hr format (e.g. 8 = 8:00 AM IST)
QUIET_HOURS_END=8

# Require human review before queueing newly discovered model leads
REQUIRE_MANUAL_REVIEW_FOR_NEW_LEADS=false
